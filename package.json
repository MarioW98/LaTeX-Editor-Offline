    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
