+/// Prima riga di `program --version` quando lo spawn riesce: è la versione
+/// mostrata in barra di stato.
+fn spawn_version(program: &str) -> Option<String> {
+    let mut cmd = Command::new(program);
     cmd.arg("--version")
         .stdin(Stdio::null())
         .stdout(Stdio::piped())
