{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaTeX Editor Offline",
  "mainBinaryName": "latex-editor-offline",
  "version": "0.2.0",
  "identifier": "com.latexeditor.offline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LaTeX Editor Offline",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Offline-first LaTeX editor",
    "longDescription": "A fully offline LaTeX desktop editor: project files stay on your disk, compilation runs locally, no account and no network access.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
